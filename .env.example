# Copy to .env and edit. .env holds secrets and must never be committed.

# --- InfluxDB (values are only read the first time the data volume is created) ---
INFLUXDB_USERNAME=microhydros
INFLUXDB_PASSWORD=replace-with-a-password
INFLUXDB_ORG=microhydros
# The provisioned Grafana dashboard queries a bucket named "microhydros". Do not rename it.
INFLUXDB_BUCKET=microhydros
# Generate with: openssl rand -hex 32
INFLUXDB_TOKEN=replace-with-a-long-random-token

# --- Grafana ---
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=replace-with-a-strong-password

# --- Node-RED editor login ---
# Required whenever Node-RED is reachable from other machines.
# Create the hash with:  ./scripts/hash-node-red-password.sh
# Keep the SINGLE QUOTES: the hash contains $ characters.
NODERED_ADMIN_USER=admin
NODERED_ADMIN_HASH=
# Any long random string. Set it before adding credentials to flows.
NODERED_CREDENTIAL_SECRET=

# --- Ports and bind addresses (defaults shown) ---
# Use 127.0.0.1 to keep a service reachable only from the server itself,
# for example behind a reverse proxy.
MQTT_BIND=0.0.0.0
MQTT_PORT=1883
NODERED_BIND=0.0.0.0
NODERED_PORT=1880
INFLUX_BIND=0.0.0.0
INFLUX_PORT=8086
GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3000

# Timezone for container logs. Stored timestamps are always UTC.
TZ=UTC

# --- Running next to other stacks on the same host ---
# COMPOSE_PROJECT_NAME prefixes container, volume and network names. Change it (and the ports
# above) to run a second copy without clashing with an existing one.
COMPOSE_PROJECT_NAME=microhydros
# Memory ceiling per container. A container that hits its ceiling is restarted on its own,
# instead of the kernel picking a victim among all containers on the host.
MOSQUITTO_MEM=128m
NODERED_MEM=512m
INFLUX_MEM=1g
GRAFANA_MEM=512m

# Example for a shared server that already runs another stack (stage E2 of docs/PLAN.md):
#   COMPOSE_PROJECT_NAME=leaflimits-test
#   MQTT_PORT=1885   NODERED_PORT=1882   INFLUX_PORT=8088   GRAFANA_PORT=3003
#   MOSQUITTO_MEM=64m   NODERED_MEM=256m   INFLUX_MEM=512m   GRAFANA_MEM=384m
